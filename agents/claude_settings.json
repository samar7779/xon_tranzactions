{
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git log)", "Bash(git log *)", "Bash(git show *)", "Bash(git diff)", "Bash(git diff *)",
      "Bash(git status)", "Bash(git status *)", "Bash(git blame *)", "Bash(python3 -m py_compile *)"
    ],
    "deny": [
      "Read(**/.env*)", "Read(//proc/**)", "Read(//etc/**)", "Read(~/**)", "Read(//root/**)",
      "Read(**/*.pem)", "Read(**/*.key)", "Read(**/*credentials*.json)", "Read(**/*service-account*.json)",
      "Read(**/abc_sheets.json)", "Read(**/uploads/**)",
      "Edit(**/.env*)", "Edit(**/.git/**)", "Bash(rm -rf *)", "Bash(sudo *)",
      "Edit", "Write", "NotebookEdit", "WebFetch", "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 agents/bin/bash_guard.py"}]}
    ]
  }
}
